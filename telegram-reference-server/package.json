{
  "name": "telegram-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Telegram Bot API with stdio and HTTP transports",
  "type": "module",
  "main": "dist/server.js",
  "bin": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "clean": "rm -rf dist/",
    "lint": "eslint src/",
    "install:all": "npm install && npm run client:install && npm run webhook-receiver:install",
    "build:all": "npm run build && npm run client:build && npm run webhook-receiver:build",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http",
    "client:install": "cd client && npm install",
    "client:build": "cd client && npm run build",
    "client:lint": "cd client && npm run lint",
    "client:start": "node client/build/main.js",
    "client:start:poll": "node client/build/main.js --poll",
    "client:start:webhook": "node client/build/main.js --webhook",
    "client:start:http": "node client/build/main.js --http",
    "client:start:http:poll": "node client/build/main.js --http --poll",
    "client:start:http:webhook": "node client/build/main.js --http --webhook",
    "webhook-receiver:start": "node webhook-receiver/dist/webhookReceiver.js",
    "webhook-receiver:install": "cd webhook-receiver && npm install",
    "webhook-receiver:build": "cd webhook-receiver && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "grammy": "^1.42.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tsconfig/recommended": "^1.0.8",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "eslint-plugin-check-file": "^3.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
